# Server
PORT
NODE_ENV
# Database
MONGODB_URI

# Redis (session store / source of truth for refresh tokens)
REDIS_URL

# Auth secrets (generate with: openssl rand -base64 48)
ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET

# Token lifetimes
ACCESS_TOKEN_TTL
REFRESH_TOKEN_TTL

# Refresh-token cookie hardening: "strict" or "lax" (lax for cross-subdomain front/back)
REFRESH_COOKIE_SAMESITE

# CORS: comma-separated allowed origins (leave empty to allow any origin in dev)
CORS_ALLOWED_ORIGINS