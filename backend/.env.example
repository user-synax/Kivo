[TEMPLATE]
# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/kivo

# Auth secrets (generate with: openssl rand -base64 48)
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Refresh-token cookie hardening: "strict" or "lax" (lax for cross-subdomain front/back)
REFRESH_COOKIE_SAMESITE=strict

# CORS: comma-separated allowed origins (leave empty to allow any origin in dev)
CORS_ALLOWED_ORIGINS=

# Appwrite Storage (avatar / DP uploads). Create a project + a bucket with
# public read ("any") permissions, then fill these in. The bucket is used by
# PATCH /api/v1/users/me/avatar.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# Appwrite bucket for message attachments (images & documents) — separate from
# the avatar bucket above; also needs public read permissions. Optional: the
# server boots without it and the upload endpoint reports BUCKET_NOT_CONFIGURED.
APPWRITE_ATTACHMENTS_BUCKET_ID=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kivo.app

# Gmail SMTP — transactional email (password reset, verification resend)
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# "From" header, e.g. "Kivo" <you@gmail.com>
EMAIL_FROM=
# Frontend base URL for email links (e.g. https://kivo.app)
FRONTEND_URL=http://localhost:3000

# OAuth — Google & GitHub signup/login + provider verification badges.
# Google: https://console.cloud.google.com/apis/credentials (Authorized redirect URI
# must match GOOGLE_REDIRECT_URI exactly).
# GitHub: https://github.com/settings/developers (Authorization callback URL
# must match GITHUB_REDIRECT_URI exactly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# Admin Panel — standalone credential pair (NOT a DB user account).
# Generate the password hash once with: node -e "const b=require('bcryptjs');b.hash('your-password',12).then(h=>console.log(h))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-admin-jwt
ADMIN_JWT_TTL=30m
ADMIN_COOKIE_NAME=admin_token
